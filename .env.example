# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Email (Brevo). Without a key, enquiries are logged to the console instead of sent.
BREVO_API_KEY=
ENQUIRY_TO_EMAIL=hello@otta.co.nz
ENQUIRY_FROM_EMAIL=no-reply@otta.co.nz

# --- Broker portal (later stages, not used yet) ---
# Neon Postgres connection string
# DATABASE_URL=
# iron-session cookie secret, at least 32 random characters
# SESSION_SECRET=
# Vercel Blob token for document uploads
# BLOB_READ_WRITE_TOKEN=
