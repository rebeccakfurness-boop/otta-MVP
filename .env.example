# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Email (Brevo). Without a key, enquiries are logged to the console instead of sent.
BREVO_API_KEY=
ENQUIRY_TO_EMAIL=hello@ottainsurance.co.nz
ENQUIRY_FROM_EMAIL=no-reply@ottainsurance.co.nz
# Online building insurance applications from the broker portal are emailed here.
APPLICATION_TO_EMAIL=rebecca@tai.co.nz
# Demo mode sends EVERY email (client links, broker notices, enquiries) to this one
# address, labelled with who it was for. Defaults to rebecca@tai.co.nz while
# PORTAL_DEMO_LOGIN is on. Set to "off" to send emails to their real recipients.
EMAIL_DEMO_TO=

# --- Broker portal (see docs/broker-portal.md) ---
# Required in production: encrypts portal sign-in cookies. 32+ random characters,
# e.g. the output of: openssl rand -base64 32
SESSION_SECRET=
# The portal's subdomain. Leave blank to serve the portal at /portal instead.
NEXT_PUBLIC_PORTAL_HOST=portal.ottainsurance.co.nz
# Show the demo account on the sign-in page (set to false once real brokers are loaded).
PORTAL_DEMO_LOGIN=true
# Single sign-on (optional; each button works once its keys are set).
PORTAL_MICROSOFT_CLIENT_ID=
PORTAL_MICROSOFT_CLIENT_SECRET=
PORTAL_MICROSOFT_TENANT_ID=organizations
PORTAL_GOOGLE_CLIENT_ID=
PORTAL_GOOGLE_CLIENT_SECRET=

# --- Admin portal (see docs/admin-portal.md) ---
# The admin subdomain. Leave blank to serve admin at /admin instead.
NEXT_PUBLIC_ADMIN_HOST=admin.ottainsurance.co.nz
# Staff SSO (optional). Admin only accepts @ottainsurance.co.nz accounts.
ADMIN_MICROSOFT_CLIENT_ID=
ADMIN_MICROSOFT_CLIENT_SECRET=
ADMIN_MICROSOFT_TENANT_ID=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=

# Neon Postgres (add the Neon integration in Vercel and this is set for you).
# Online applications and client links are saved here; without it they are kept in
# memory and reset when the server restarts.
DATABASE_URL=
# Later: Vercel Blob for documents
# BLOB_READ_WRITE_TOKEN=

# Steve the otter chatbot (Claude). Without a key Steve uses simple built-in answers.
ANTHROPIC_API_KEY=
